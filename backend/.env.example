# MongoDB Atlas Connection
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=packintel

# Frontend URL for CORS (e.g., https://sih2026-2.vercel.app)
FRONTEND_URL=https://sih2026-2.vercel.app

# Port for backend server (Render automatically sets $PORT)
PORT=8000

# AI Provider Configuration (groq, openai, gemini, or none)
AI_PROVIDER=groq
AI_API_KEY=
AI_MODEL=openai/gpt-oss-120b
AI_VISION_MODEL=qwen/qwen3.8-27b

# Optional: Groq Base URL
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Optional Weather / Geocoding API endpoints (free, no key required)
OPEN_METEO_GEOCODING_URL=https://geocoding-api.open-meteo.com/v1/search
OPEN_METEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast

# Optional scoring weights overrides (JSON)
RECOMMENDATION_WEIGHTS=
